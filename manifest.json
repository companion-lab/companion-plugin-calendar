{
  "id": "calendar",
  "name": "Calendar",
  "version": "0.5.0",
  "description": "Dated events, birthdays, and appointments: a settings tab, reminder banners, and calendar tools the avatar can call.",
  "abi": 3,
  "permissions": [
    "storage",
    "events",
    "tools"
  ],
  "frontend": {
    "entry": "frontend.js"
  },
  "backend": {
    "library": "libcalendar_backend.dylib"
  },
  "versionCheckUrl": "https://github.com/companion-lab/companion-plugin-calendar/releases/latest",
  "updateUrl": "https://github.com/companion-lab/companion-plugin-calendar/releases/latest/download/calendar-{version}-{platform}.zip"
}
